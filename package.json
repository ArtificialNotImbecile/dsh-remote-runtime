{
  "name": "@artificialnotimbecile/dsh-remote-runtime",
  "version": "0.1.2",
  "description": "Managed, isolated DeepSeek Harness runtimes over OpenSSH with a native Web control surface.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "dsh-remote": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client-types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/cli.js",
    "lib/cli.js.map",
    "lib/types.js",
    "lib/types.js.map",
    "lib/service-*.js",
    "lib/service-*.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/client-types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "runtime/manifest.json",
    "runtime/package.json",
    "runtime/pnpm-lock.yaml",
    "runtime/pnpm-workspace.yaml",
    "docs/assets/readme/*",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "generate:typert": "node scripts/generate-typert.mjs",
    "build:host": "tsc -b tsconfig.host.json && tsdown --config tsdown.host.config.ts && pnpm run generate:typert",
    "build:client": "tsc -b tsconfig.client.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "pnpm run clean && tsc -b tsconfig.host.json --pretty false && pnpm run generate:typert && tsc -b tsconfig.client.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check",
    "pack:check": "node scripts/check-package.mjs",
    "runtime:build": "node scripts/build-runtime.mjs",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "runtime:abi": "node scripts/check-runtime-abi.mjs",
    "runtime:fingerprint": "node scripts/fingerprint-runtime.mjs",
    "test:dsh-install": "node scripts/test-dsh-install.mjs",
    "test:live": "node scripts/test-live.mjs",
    "prepare": "pnpm run build",
    "prepack": "pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtificialNotImbecile/dsh-remote-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/ArtificialNotImbecile/dsh-remote-runtime/issues"
  },
  "homepage": "https://github.com/ArtificialNotImbecile/dsh-remote-runtime#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "remote-runtime",
    "remote-development",
    "ssh",
    "ai-agents"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "undici": "7.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "lightningcss": "1.30.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.1.2",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
