{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/client-types",
    "tsBuildInfoFile": "lib/.client.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/css-modules.d.ts",
    "src/types.ts"
  ]
}
